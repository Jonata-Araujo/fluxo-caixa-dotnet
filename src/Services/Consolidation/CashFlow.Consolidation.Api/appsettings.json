{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ConsolidationDb": "Host=localhost;Port=5432;Database=cashflow_consolidation;Username=cashflow;Password=cashflow;Maximum Pool Size=50"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ConsumerEnabled": true,
    "PrefetchCount": 50,
    "MaxProcessingAttempts": 3,
    "DeliveryLimit": 10
  },
  "BalanceCache": {
    "Enabled": true,
    "TimeToLive": "00:00:05"
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "QueueLimit": 50
  }
}
